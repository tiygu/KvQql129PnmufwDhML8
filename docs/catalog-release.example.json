{
  "releaseId": "catalog-icons-YYYY-MM-DD",
  "decisionOwner": "ROLE",
  "knownLimitations": [
    "Replace this text with the limitations observed during the release rehearsal."
  ],
  "artifacts": {
    "migration": ".release-inputs/catalog-migration.json",
    "performance": ".release-inputs/catalog-performance.json",
    "runtimeSmoke": ".release-inputs/catalog-runtime-smoke.json",
    "screenshots": [
      ".release-inputs/screenshots/catalog-directory-detail.png",
      ".release-inputs/screenshots/catalog-icon-evidence-groups.png",
      ".release-inputs/screenshots/catalog-minimum-viewport.png"
    ]
  },
  "performanceThresholds": {
    "queryP95Ms": 250,
    "projectionRebuildMs": 2000
  },
  "entryModeGuard": {
    "id": "guard-legacy-entry-mode",
    "command": "node",
    "args": [
      "scripts/catalog-release-entry-mode.cjs",
      "--base-url",
      "http://127.0.0.1:3210",
      "--entry-mode",
      "legacy-advanced"
    ]
  },
  "stages": {
    "compatible-migration": [
      {
        "id": "migration-rehearsal",
        "command": "node",
        "args": [
          "scripts/catalog-release-rehearse.cjs",
          "--output",
          ".release-work/catalog-migration",
          "--evidence",
          ".release-inputs/catalog-migration.json"
        ]
      },
      {
        "id": "migration-contract",
        "command": "node",
        "args": [
          "--test",
          "test/catalog-release-compatibility.test.js",
          "test/icon-evidence-migration.test.js",
          "test/catalog-release-gates.test.js"
        ]
      }
    ],
    "read-only-catalog": [
      {
        "id": "api-contract",
        "command": "node",
        "args": [
          "--test",
          "test/catalog-item-query.integration.test.js",
          "test/control-server.test.js"
        ]
      },
      {
        "id": "catalog-performance",
        "command": "node",
        "args": [
          "scripts/catalog-release-performance.cjs",
          "--catalog-size",
          "5000",
          "--evidence",
          ".release-inputs/catalog-performance.json"
        ]
      },
      {
        "id": "browser-e2e",
        "command": "node",
        "args": [
          "--test",
          "test/catalog-item-directory.browser.test.js"
        ],
        "env": {
          "CATALOG_RELEASE_SCREENSHOT_DIR": ".release-inputs/screenshots"
        }
      }
    ],
    "icon-write": [
      {
        "id": "job-contract",
        "command": "node",
        "args": [
          "--test",
          "test/icon-harvest-job.test.js",
          "test/icon-harvest-lifecycle.test.js",
          "test/icon-harvest-console.test.js"
        ]
      },
      {
        "id": "repository-check",
        "command": "npm",
        "args": [
          "run",
          "check"
        ]
      },
      {
        "id": "web-build",
        "command": "npm",
        "args": [
          "run",
          "web:build"
        ]
      },
      {
        "id": "package-files",
        "command": "node",
        "args": [
          "scripts/catalog-release-package-check.cjs"
        ]
      },
      {
        "id": "real-runtime-smoke",
        "command": "node",
        "args": [
          "scripts/catalog-release-runtime-smoke.cjs",
          "--base-url",
          "http://127.0.0.1:3210",
          "--merge-chain-id",
          "TARGET_CHAIN_ID",
          "--minimum-members",
          "20",
          "--minimum-succeeded",
          "15",
          "--maximum-deferred",
          "5",
          "--maximum-failed",
          "0",
          "--maximum-cancelled",
          "0",
          "--rollback-observations",
          ".release-inputs/catalog-rollback-observations.json",
          "--evidence",
          ".release-inputs/catalog-runtime-smoke.json"
        ]
      }
    ]
  },
  "activation": {
    "id": "activate-full-snapshot",
    "command": "node",
    "args": [
      "scripts/catalog-release-entry-mode.cjs",
      "--base-url",
      "http://127.0.0.1:3210",
      "--entry-mode",
      "full-snapshot"
    ]
  },
  "packaging": {
    "requiredFiles": [
      "package.json",
      "run.cjs",
      "public/index.html",
      "scripts/catalog-release-entry-mode.cjs",
      "scripts/catalog-release-runtime-smoke.cjs",
      "wmpf/src/index.js",
      "wmpf/src/cdp_automation.js",
      "wmpf/frida/hook.js"
    ]
  },
  "rollback": {
    "switchEntryMode": {
      "id": "rollback-entry-mode",
      "command": "node",
      "args": [
        "scripts/catalog-release-entry-mode.cjs",
        "--base-url",
        "http://127.0.0.1:3210",
        "--entry-mode",
        "legacy-advanced"
      ]
    },
    "switchServiceVersion": {
      "id": "rollback-service-version",
      "command": "TARGET_SERVICE_SWITCH",
      "args": [
        "PREVIOUS_SERVICE_VERSION"
      ]
    },
    "restoreBackup": {
      "id": "restore-damaged-database",
      "command": "TARGET_BACKUP_RESTORE",
      "args": [
        "BACKUP_PATH"
      ]
    }
  }
}
